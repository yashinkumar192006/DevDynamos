# =============================================
# ContextShield — Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# For local development using the dedicated app user:
DATABASE_URL=postgresql+asyncpg://contextshield_app:contextshield_pass@localhost:5432/contextshield

# --- JWT / Authentication ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Login throttling (failure-only sliding window, per process) ---
# Failed sign-ins per (username + client address) before 429 + Retry-After
# AUTH_RATE_LIMIT_MAX_FAILURES=10
# Failed sign-ins per client address (rotating usernames cannot dodge the limit)
# AUTH_RATE_LIMIT_IP_MAX_FAILURES=50
# Window length in seconds for both counters
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Set to false only for load tests; leave enabled in any exposed deployment
# AUTH_RATE_LIMIT_ENABLED=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM Provider ---
# "mock" (default, offline, deterministic) or "gemini" (requires the key below)
LLM_PROVIDER=mock
# Optional model override, e.g. gemini-2.5-flash
# LLM_MODEL=
# Server-side only. NEVER expose this to a frontend or commit a real key.
# GEMINI_API_KEY=
# Canned deterministic mock response (optional; useful to demo a leaky provider)
# LLM_MOCK_RESPONSE=
# Provider call timeout (seconds) and transient retry count
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=1
# Output privacy guard: enable/disable and enforcement mode
# LLM_OUTPUT_GUARD_ENABLED=true
# redact (sanitize) | reject (withhold) | escalate (withhold + review)
LLM_OUTPUT_GUARD_MODE=redact
# Maximum output length the guard scans; longer output is truncated
# LLM_MAX_OUTPUT_CHARS=100000

# --- Frontend ---
# Origin only — the client appends /api/v1/... itself. Do NOT add /api/v1.
# For frontend-only overrides, use frontend/.env.local (see frontend/.env.example).
VITE_API_BASE_URL=http://localhost:8000
